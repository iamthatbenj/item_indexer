# Copy to .env.local. Never commit credentials or local records.
TURSO_DATABASE_URL=file:.local/development.db
# Required for a remote Turso database; omit for a local file.
TURSO_AUTH_TOKEN=
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# File delivery is development-only, with a local file database. Never put this under public/.
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=.local/outbox
# Production uses SMTP; hosting/domain/provider activation is ticket #3.
# MAIL_TRANSPORT=smtp
# MAIL_FROM=Family Belongings <signin@example.com>
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=

# Private S3-compatible photo storage. Required only when saving/viewing photos.
# Use a separate development bucket/server, never production resources locally.
# Cloudflare R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
# Local SeaweedFS setup: docs/development/photo-drafts.md
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9200
OBJECT_STORAGE_BUCKET=family-development
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-development-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-development-secret
