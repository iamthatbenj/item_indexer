{
  "name": "family-belongings",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts migrate",
    "founder:approve": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts approve",
    "founder:revoke": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts revoke",
    "test": "playwright test"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
